{
  "name": "@openfaq/api",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev:web": "npm run dev -w @openfaq/web",
    "dev": "concurrently -n api,web -c green,blue \"npm run start:dev\" \"npm run dev:web\"",
    "build:web": "npm run build -w @openfaq/web",
    "build:all": "npm run build && npm run build:web",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && npm run typecheck -w @openfaq/web",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=e2e",
    "test:integration": "jest --runInBand test/integration.spec.ts",
    "test:e2e": "jest --runInBand test/app.e2e-spec.ts",
    "test:cov": "jest --runInBand --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "line:smoke": "tsx scripts/line-smoke.ts",
    "sit:setup": "bash scripts/sit-setup.sh",
    "sit:up": "docker compose up -d --build",
    "sit:check": "bash scripts/sit-check.sh",
    "sit:down": "docker compose down",
    "tunnel": "bash scripts/tunnel.sh",
    "admin:hash-password": "tsx scripts/hash-password.ts",
    "model:setup": "tsx scripts/model-setup.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "@langchain/textsplitters": "^1.0.1",
    "@line/bot-sdk": "^10.2.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.13.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cheerio": "^1.1.2",
    "helmet": "^8.1.0",
    "openai": "^5.12.2",
    "pdf-parse": "^1.1.1",
    "pino": "^9.7.0",
    "prisma": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "jest": "^30.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
