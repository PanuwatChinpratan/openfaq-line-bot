generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FaqStatus {
  draft
  published
  needs_review
  archived
}

model Faq {
  id          String       @id
  category    String
  question    String
  normalized  String
  answer      String
  source      String
  status      FaqStatus    @default(draft)
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  publishedAt DateTime?    @map("published_at")
  variants    FaqVariant[]
  revisions   FaqRevision[]
  feedback    Feedback[]

  @@index([category, status])
  @@map("faqs")
}

model FaqVariant {
  id         String   @id @default(cuid())
  faqId      String   @map("faq_id")
  text       String
  normalized String
  faq        Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, normalized])
  @@map("faq_variants")
}

model FaqRevision {
  id        String   @id @default(cuid())
  faqId     String   @map("faq_id")
  question  String
  answer    String
  variants  Json
  status    FaqStatus
  createdAt DateTime @default(now()) @map("created_at")
  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@index([faqId, createdAt])
  @@map("faq_revisions")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("admin_sessions")
}

model QueryLog {
  id             String   @id @default(cuid())
  sanitizedQuery String   @map("sanitized_query")
  decision       String
  confidence     Float
  faqId          String?  @map("faq_id")
  latencyMs      Int      @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("query_logs")
}

model Feedback {
  id        String   @id @default(cuid())
  faqId     String?  @map("faq_id")
  helpful   Boolean
  createdAt DateTime @default(now()) @map("created_at")
  faq       Faq?     @relation(fields: [faqId], references: [id], onDelete: SetNull)

  @@map("feedback")
}

model WebhookReceipt {
  eventId     String   @id @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at")
  status      String

  @@map("webhook_receipts")
}
